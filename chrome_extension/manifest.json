{
  "manifest_version": 3,
  "name": "Sara SOP Capture",
  "version": "1.3.0",
  "description": "Capture or import images, organize them into SOP steps, and add descriptions.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "sidePanel", "clipboardWrite"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Sara SOP"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
