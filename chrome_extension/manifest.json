{
  "manifest_version": 3,
  "name": "Python SOP Capture",
  "version": "1.1.0",
  "description": "Capture Chrome tabs and organize screenshots into SOP steps.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "sidePanel", "clipboardWrite"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Python SOP"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
